            "hash": "25140bd720b8738356fcede058e7ab01364d64315bf3a1596c9dd486a49215a3"
        }
    },
    "installer": {
        "script": "Expand-7zipArchive \"$dir\\chrome.7z\" -ExtractDir 'Chrome-bin' -Removal"
